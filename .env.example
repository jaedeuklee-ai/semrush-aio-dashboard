# ---------------------------------------------------------------------------
# Supabase (Vercel -> Project -> Settings -> Environment Variables, or the
# Supabase Marketplace integration which injects these automatically)
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Server-only. Use the new Secret key (sb_secret_...) or the legacy
# service_role key. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# SEMrush Enterprise AIO (used by the daily sync route /api/cron/sync)
# ---------------------------------------------------------------------------
SEMRUSH_API_KEY=
SEMRUSH_WORKSPACE_ID=
SEMRUSH_PROJECT_ID=
SEMRUSH_VISIBILITY_ELEMENT_ID=
# Phase 3 topic-level citations element (used by /api/cron/citations)
SEMRUSH_TOPIC_CITATIONS_ELEMENT_ID=

# ---------------------------------------------------------------------------
# Secrets that protect the routes
# ---------------------------------------------------------------------------
# Set CRON_SECRET so only Vercel Cron can call /api/cron/sync. Vercel sends it
# automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# A token you choose, required to trigger /api/admin/load and manual syncs.
ADMIN_TOKEN=

# Claude API — powers the Ask AI agent (/agent)
ANTHROPIC_API_KEY=
# optional, defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6
