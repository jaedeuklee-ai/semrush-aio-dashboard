# ---------------------------------------------------------------------------
# Supabase connection (get these from Supabase dashboard → Project Settings → API)
# When you provision Supabase through the Vercel Marketplace, these are injected
# automatically into your Vercel project. For local dev, copy this file to
# `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service role key — SERVER ONLY. Never expose this to the browser / client code.
# Used by server components, API routes, and the seed/import scripts.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Agent (next phase — not required for the dashboard to run)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
